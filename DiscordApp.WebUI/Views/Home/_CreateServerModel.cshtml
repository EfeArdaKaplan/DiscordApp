<!-- SUNUCU EKLEME MODAL (POPUP) -->
<div id="createServerModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#2b2d31; padding:24px; border-radius:8px; width:380px; box-shadow:0 8px 24px rgba(0,0,0,0.5); color:#dbdee1;">
        <h3 style="margin-top:0; color:#fff;">Sunucu Oluştur</h3>
        <p style="font-size:13px; color:#949ba4;">Yeni sunucuna bir isim ver. İstediğin zaman değiştirebilirsin.</p>

        <label style="font-size:12px; font-weight:bold; color:#b5bac1; display:block; margin-bottom:8px;">SUNUCU ADI</label>
        <input type="text" id="newServerNameInput" placeholder="Örn: Yazılım Ekibi" style="width:100%; padding:10px; border-radius:4px; border:none; background:#1e1f22; color:#fff; box-sizing:border-box; margin-bottom:20px; outline:none;" />

        <div style="display:flex; justify-content:flex-end; gap:12px;">
            <button onclick="closeServerModal()" style="background:transparent; border:none; color:#fff; cursor:pointer; padding:8px 16px;">İptal</button>
            <button onclick="submitNewServer()" style="background:#5865f2; border:none; color:#fff; padding:8px 20px; border-radius:4px; cursor:pointer; font-weight:500;">Oluştur</button>
        </div>
    </div>
</div>