@model DiscordApp.WebUI.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "_Layout";
}

<div id="page-landing" class="page">
  <div class="center">
    <div class="card-wrap">
      <div class="logo">APP</div>
      <h1 class="title-h1">Chat App</h1>
      <p class="subtitle">Sende bize katıl!</p>
      <div class="card">
                @if (ViewBag.ErrorMessage != null && ViewBag.ErrorMessage is string && ((string)ViewBag.ErrorMessage).Trim().Length > 0)
                {
                    <div class="system-error-box" style="background: rgba(229, 72, 77, 0.1); border: 1px solid #E5484D; color: #E5484D; padding: 10px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; text-align: center; font-weight: 500;">
                        ⚠️ @ViewBag.ErrorMessage
                    </div>
                }
        <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post" novalidate>
          @Html.AntiForgeryToken()

          <div class="form-group" id="group-loginEmail">
            <label class="field-label">E-posta</label>
            <div class="field">
              <span class="icon">✉️</span>
              <input name="Email" id="loginEmailInput" type="email" value="@Model?.Email" placeholder="ör. sofia@@ornek.com" />
            </div>
            <ul class="error-list" id="err-loginEmail"></ul>
          </div>

          <div class="form-group" id="group-loginPassword">
            <label class="field-label">Parola</label>
            <div class="field">
              <span class="icon">🔒</span>
              <input name="Password" id="loginPassInput" type="password" placeholder="••••••••" />
            </div>
            <ul class="error-list" id="err-loginPassword"></ul>
          </div>

          <button type="submit" class="btn-primary">Sohbete gir →</button>
        </form>
      </div>
      <p class="hint">Hesabın yok mu? <a asp-controller="Auth" asp-action="Register" style="color:var(--accent);text-decoration:none;font-weight:500;">Kayıt ol</a></p>
    </div>
  </div>
  <div class="console">
    <span><span style="color:var(--mint)">▸</span> </span>
    <span class="right" style="display:flex">
      <span class="hide-mobile">🛡 sunucu bulutta değil</span>
    </span>
  </div>
</div>

@section Scripts {
    <script src="~/js/login.js"></script>
}