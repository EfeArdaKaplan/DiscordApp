@model DiscordApp.WebUI.Models.RegisterViewModel
@{
    ViewData["Title"] = "Hesap Oluştur";
    Layout = "_Layout";
}

<div id="page-register" class="page">
    <div class="center">
        <div class="card-wrap">
            <div class="logo">YS</div>
            <h1 class="title-h1">Hesap Oluştur</h1>
            <p class="subtitle">Kayıt bilgilerin sadece bu makinede, yerel olarak saklanır.</p>
            <div class="card">
                @if (ViewBag.ErrorMessage != null && ViewBag.ErrorMessage is string && ((string)ViewBag.ErrorMessage).Trim().Length > 0)
                {
                    <div class="system-error-box" style="background: rgba(229, 72, 77, 0.1); border: 1px solid #E5484D; color: #E5484D; padding: 10px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; text-align: center; font-weight: 500;">
                        ⚠️ @ViewBag.ErrorMessage
                    </div>
                }
                <form id="registerForm" asp-controller="Auth" asp-action="Register" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="form-group" id="group-regName">
                        <label class="field-label">Rumuz</label>
                        <div class="field">
                            <span class="icon">👤</span>
                            <input name="UserName" id="regNameInput" value="@Model?.UserName" placeholder="ör. Sofia" />
                        </div>
                        <ul class="error-list" id="err-regName"></ul>
                    </div>

                    <div class="form-group" id="group-regEmail">
                        <label class="field-label">E-posta</label>
                        <div class="field">
                            <span class="icon">✉️</span>
                            @* placeholder'daki "@" literal metin olduğu için @@ ile yazıldı *@
                            <input name="Email" id="regEmailInput" type="email" value="@Model?.Email" placeholder="ör. sofia@@ornek.com" />
                        </div>
                        <ul class="error-list" id="err-regEmail"></ul>
                    </div>

                    <div class="form-group" id="group-regPassword">
                        <label class="field-label">Parola</label>
                        <div class="field">
                            <span class="icon">🔒</span>
                            <input name="Password" id="regPassInput" type="password" placeholder="••••••••" />
                        </div>
                        <ul class="error-list" id="err-regPassword"></ul>
                    </div>

                    <button type="submit" class="btn-primary">Hesap oluştur ve gir →</button>
                </form>
            </div>
            <p class="hint">Zaten hesabın var mı? <a asp-controller="Auth" asp-action="Login" style="color:var(--accent);text-decoration:none;font-weight:500;">Giriş yap</a></p>
        </div>
    </div>
    <div class="console">
        <span><span style="color:var(--mint)">▸</span> yerel://localhost:4000</span>
        <span class="right" style="display:flex">
            <span>📶 p2p bağlantı bekleniyor</span>
            <span class="hide-mobile">🛡 sunucu bulutta değil</span>
        </span>
    </div>
</div>

@section Scripts {
    <script src="~/js/register.js"></script>
}